{
  "shape": "package",
  "pkg": "@itoby/ui",
  "projectId": "67e97c04-78f9-4f5c-bcee-f4cea5a59bb2",
  "globalName": "ItobyUI",
  "buildCmd": "pnpm --filter @itoby/ui build",
