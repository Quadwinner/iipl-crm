{
  "name": "@itoby/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./supabase": "./src/supabase/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "gen:types": "supabase gen types typescript --linked --schema public > src/types/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.0"
  },
  "devDependencies": {
    "oxlint": "^1.71.0",
    "supabase": "^2.109.1",
    "typescript": "~6.0.2"
  }
}
