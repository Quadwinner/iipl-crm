{
  "name": "itoby-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:admin": "pnpm --filter admin-portal dev",
    "dev:owner": "pnpm --filter owner-portal dev",
    "dev:web": "pnpm --filter web dev",
    "sync:rental": "node scripts/sync-rental.mjs",
    "sync:rental:check": "node scripts/sync-rental.mjs --check",
    "build": "pnpm --filter @itoby/ui build && pnpm -r --sequential --filter \"!@itoby/ui\" build",
    "typecheck": "pnpm -r --sequential typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "pnpm --filter @itoby/shared gen:types",
    "seed:admin": "node scripts/seed-admin.mjs",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@vitest/ui": "^4.1.10",
    "dotenv": "^17.4.2",
    "fast-check": "^4.9.0",
    "prettier": "3.6.2",
    "supabase": "2.109.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
