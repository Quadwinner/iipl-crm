{
  "framework": "vite",
  "buildCommand": "cd ../.. && pnpm --filter @itoby/ui build && pnpm --filter web build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/home",
      "destination": "/app/rental/home"
    },
    {
      "source": "/lease",
      "destination": "/app/rental/lease"
    },
    {
      "source": "/invoices",
      "destination": "/app/rental/invoices"
    },
    {
      "source": "/reminders",
      "destination": "/app/rental/reminders"
    },
    {
      "source": "/receipts",
      "destination": "/app/rental/receipts"
    },
    {
      "source": "/complaints",
      "destination": "/app/rental/complaints"
    },
    {
      "source": "/documents",
      "destination": "/app/rental/documents"
    },
    {
      "source": "/profile",
      "destination": "/app/rental/profile"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
