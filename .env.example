# Copy this file to .env and fill in real values. Never commit .env.
# Get these from Supabase Dashboard > Project Settings > API

# Safe for frontend/browser use (public, but still don't commit the filled-in file out of habit)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY — full admin access, bypasses RLS. Never expose to any frontend/browser bundle.
# Used only by Edge Functions / trusted backend scripts (e.g. Supabase Auth admin API calls).
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay publishable key id — exposed to the browser via Vite (safe, public)
VITE_RAZORPAY_KEY_ID=

# Payment gateway secrets (server-side / Edge Function only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_SHARED_SECRET=

# Email / SMS providers (server-side / Edge Function only)
# EMAIL_PROVIDER_API_KEY is a Resend API key. EMAIL_FROM must be a Resend-verified sender;
# onboarding@resend.dev works for testing but only delivers to your own account address.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
SMS_PROVIDER_API_KEY=

# Base URL used in notification email links
OWNER_PORTAL_URL=

# Where the superapp is deployed. Canonical URLs and Open Graph tags use it;
# without it each deployment claims its own origin, which is right for previews
# and wrong for production behind a custom domain.
VITE_SITE_ORIGIN=
